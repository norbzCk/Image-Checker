# Copy to .env (or run scripts/init-env.sh, which generates strong secrets).
# Never commit .env.
DB_NAME=imagecheck
DB_USER=imagecheck_user
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
INFERENCE_TOKEN=change-me-three
APP_SECRET=change-me-four-at-least-16-chars

# Detection model (free, from Hugging Face). Check the model card's licence before
# using it commercially. AI_LABELS = label name(s) of that model meaning "AI-generated".
MODEL_BACKEND=hf
MODEL_ID=umm-maybe/AI-image-detector
AI_LABELS=artificial,ai,fake,generated,ai-generated
# MODEL_REVISION=<commit hash to pin an exact model version>
